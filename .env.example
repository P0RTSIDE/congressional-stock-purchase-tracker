# API keys — copy to .env and fill in (never commit .env)
CONGRESS_GOV_API_KEY=
LDA_API_KEY=
OPENFEC_API_KEY=

# Database
DATABASE_PATH=data/processed/voting_donor_tracker.db

# Analysis defaults
DEFAULT_CONGRESS=118
DEFAULT_CYCLE=2024
TOP_N_DONORS=20
FUZZY_MATCH_THRESHOLD=85

# Congressional stock trades (CongressInvests public API — no key required)
CONGRESS_STOCK_API_URL=https://congressinfor-production.up.railway.app
